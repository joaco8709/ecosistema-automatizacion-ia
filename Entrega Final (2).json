    {
      "parameters": {
        "jsCode": "// Captura el texto generado provenga de 'text', 'message.content' o 'output'\nconst rawOutput = $json.text || $json.message?.content || $json.output?.[0]?.content?.[0]?.text || $json.output || JSON.stringify($json);\n\n// Elimina bloques de markdown si el modelo envolvió la salida en ```json ... ```\nconst cleaned = typeof rawOutput === 'string' \n  ? rawOutput.replace(/```json/gi, '').replace(/```/gi, '').trim()\n  : JSON.stringify(rawOutput);\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { error: \"No se pudo parsear el JSON\", raw: cleaned };\n}\n\nreturn {\n  json: {\n    prioridad: parsed.prioridad || \"Baja\",\n    clasificacion: parsed.clasificacion || \"Consulta Estándar / Baja\",\n    propuesta: parsed.propuesta || \"\"\n  }\n};"
      },
